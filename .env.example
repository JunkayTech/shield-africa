# ──────────────────────────────────────────────────────────────
# Shield Africa — Admin & Cloudflare configuration
# Copy this file to .env.local and fill in the values.
# ──────────────────────────────────────────────────────────────

# ---- Admin login ----
# Credentials the admin uses at /admin/login
ADMIN_EMAIL=admin@shieldafrica.org
ADMIN_PASSWORD=change-me-to-a-strong-password

# Secret used to sign admin session tokens (any long random string).
# Generate one with:  openssl rand -base64 32
ADMIN_AUTH_SECRET=

# ---- Cloudflare R2 (media + content storage) ----
# Cloudflare Dashboard → R2 → Overview → "Account ID"
R2_ACCOUNT_ID=

# Cloudflare Dashboard → R2 → "Manage R2 API Tokens" → Create API Token
# (Object Read & Write permission on your bucket)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Name of the R2 bucket, e.g. shield-africa-media
R2_BUCKET=

# Public base URL of the bucket. Either the r2.dev public URL
# (Bucket → Settings → Public access) or a connected custom domain,
# e.g. https://pub-xxxxxxxx.r2.dev or https://media.shieldafrica.org
R2_PUBLIC_URL=
